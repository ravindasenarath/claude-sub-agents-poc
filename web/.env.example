# Base URL of the backend's unauthenticated public-api surface.
NEXT_PUBLIC_PUBLIC_API_BASE_URL=http://localhost:8080/api/public

# Base URL of the backend's authenticated agent-api surface.
NEXT_PUBLIC_AGENT_API_BASE_URL=http://localhost:8080/api/agent

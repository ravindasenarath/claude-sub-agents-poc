# Copy to .env.local for local development.
# See src/lib/api/config.ts, src/lib/api/server-config.ts, src/lib/auth/config.ts.

# Base URL of the backend's unauthenticated public-api surface. Browsers
# call this directly (public/search/listing-detail pages) — unaffected by
# F0.2's agent-auth work.
NEXT_PUBLIC_PUBLIC_API_BASE_URL=http://localhost:8080/api/public

# Base URL of the backend's authenticated agent-api surface. Server-only —
# deliberately NOT a NEXT_PUBLIC_ var. As of F0.2 the browser never calls
# this origin directly: it calls the same-origin BFF proxy at /api/agent/*
# (app/api/agent/[...path]/route.ts), which reads this var and attaches the
# bearer token server-side.
AGENT_API_BASE_URL=http://localhost:8080/api/agent

# When "true", the BFF proxy's GET /api/agent/me returns a canned mock agent
# profile instead of forwarding to AGENT_API_BASE_URL. Useful for local
# frontend dev before the backend agent-api (B0.2a/B0.2b) exists — set
# AGENT_API_MOCK_STATUS=PENDING_APPROVAL to preview the pending-approval
# banner. Never set true in production.
AGENT_API_MOCK=true
AGENT_API_MOCK_STATUS=ACTIVE

# --- OIDC (agent authentication, ADR-0002) ---
# The actual identity provider is still undecided; these are placeholders so
# the app runs locally without one configured. Point OIDC_ISSUER at a real
# provider (or set OIDC_AUTHORIZATION_ENDPOINT/OIDC_TOKEN_ENDPOINT directly
# to skip discovery) before wiring up real login.
OIDC_ISSUER=https://idp.invalid
# OIDC_AUTHORIZATION_ENDPOINT=
# OIDC_TOKEN_ENDPOINT=
OIDC_CLIENT_ID=property-listing-web
# OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
OIDC_SCOPES="openid profile email offline_access"
# Provider-specific hosted-signup query param convention (e.g. Auth0's
# screen_hint=signup) — used by the login page's "Create account" link.
OIDC_SIGNUP_PARAM=screen_hint
OIDC_SIGNUP_PARAM_VALUE=signup

# Symmetric secret used to encrypt the session + pre-auth cookies
# (src/lib/auth/crypto.ts). Must be a real, random secret of at least 32
# bytes in any real deployment (e.g. `openssl rand -base64 32`) — never reuse
# the placeholder below outside local dev. `src/lib/auth/config.ts` refuses
# to boot in production (NODE_ENV=production, outside of `next build` itself)
# with this placeholder or an unset SESSION_SECRET.
SESSION_SECRET=dev-only-insecure-secret-change-me
